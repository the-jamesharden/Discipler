# Local Supabase. `supabase start` prints these; the local anon key is the same
# fixed demo value on every machine, so it is filled in here rather than left blank
# for the app to fail on. Confirm both against what `npm run db:start` prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Command-side writes run on a trusted connection, never from the browser.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Where the links Discipler texts point. An Invitation Link is read off a phone
# with no browser history behind it, so it has to be absolute.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Creating a Leader account is the one act with no session behind it, so it is
# the one place that needs this key. Never `NEXT_PUBLIC_`: it must not reach a
# browser. `npm run db:start` prints it.
SUPABASE_SERVICE_ROLE_KEY=

# The delivery vendor. Twilio lives behind `MessageTransport` and nowhere else, and
# these are needed only by a deployment that actually sends -- a developer running
# the Roster locally never reaches for them. The number to send *from* is
# deliberately not here: it is the shared number each (phone, church) pair was
# given (`sending_number_assignment`), because one number in the environment would
# text every church's people from one number, and a `STOP` to one church would
# silence them all.
TWILIO_ACCOUNT_SID=
# `TWILIO_AUTH_TOKEN` is *also* what `/sms/inbound` verifies `X-Twilio-Signature`
# with, so it is no longer needed only by a deployment that sends: unset means the
# webhook refuses everybody, the same way round as `CRON_SECRET` below. A number is
# public, and unverified that route acts on the say-so of one -- `STOP` opts a
# congregant out, `PAUSE` suspends a relationship, `C` raises a Concern against
# somebody's name. Local development needs a value here only to exercise the webhook;
# any non-empty string will do, because the tests sign with whatever this is set to.
TWILIO_AUTH_TOKEN=

# The Twilio Verify service named "Discipler", which texts the 6-digit code that
# checks an Admin's own phone before their first test check-in. Its code length (6),
# code lifetime (10 minutes, the default) and countries (the United States only)
# are set on the service in the Twilio console, not here. Verify sends from
# Twilio's own senders under the account above, so it needs no number of ours.
# Unset, a code is never sent and the Admin is told so; nothing else is affected.
TWILIO_VERIFY_SERVICE_SID=

# Supabase Auth's own SMS provider, which is a different thing from those above
# and is not what Discipler sends through. It exists because the credential is a
# phone number and a password for every user, and the phone provider is one switch:
# with no SMS provider named, Supabase turns phone login off entirely and nobody can
# sign in. One-time codes are post-launch, so nothing asks it to send anything and
# these may be left empty in local development. See
# docs/adr/0008-the-phone-number-is-the-sign-in-credential.md.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# What the scheduler proves it is with. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET` to `/cron/tick`. Unset means the route
# refuses everybody, which is the right way round: the endpoint runs the week's
# check-ins, and a deployment that forgot to set this must not be one where anybody
# can drive it.
CRON_SECRET=

# Email, through Resend (Exponential launch, ticket 10). Resend lives behind
# `EmailTransport` and nowhere else, and every email is opened by the one sender
# in `src/service/email-sender.ts` before it reaches it. Both are set by the Resend
# integration on the Vercel Production environment only, with a sending-only key
# restricted to the domain, so Preview and a developer's machine send no email:
# leave them empty here. The domain is the one Resend verified and every email is
# sent from, `notify.trydiscipler.com` in production; replies go to
# support@trydiscipler.com whatever it is.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Staging only. A Resend key cannot be held to one recipient, so on staging every
# email goes to this one address instead of whoever it was for, and a staging send
# without it is refused. Ignored everywhere but staging.
STAGING_EMAIL_RECIPIENT=

# Which deployment this is: `staging` on the staging copy, unset everywhere else.
# Vercel's custom environment named `staging` counts as staging even without it.
# A staging deployment refuses to build or start while it carries anything of
# production's: its Supabase project, a Twilio credential, a Stripe live key or its
# address. See src/platform/deployment.ts and docs/agents/test-environment.md.
DISCIPLER_ENVIRONMENT=

# How a text leaves: `twilio` (the default when unset) or `record`, which writes
# each text to the log and sends nothing. Staging must say `record`; production
# refuses it, because recording there would drop every text without a word. A
# developer may set it locally to read what the app would have texted.
MESSAGE_TRANSPORT=

# Staging only. Twilio never calls staging, so `/sms/inbound` there accepts only a
# test text signed with this, by `npm run staging:text`. Unset means the route
# refuses everybody. Ignored everywhere but staging, where TWILIO_AUTH_TOKEN is
# ignored in turn.
STAGING_SMS_SIGNING_SECRET=
